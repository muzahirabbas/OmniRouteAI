# OmniRouteAI Local Daemon Environment Variables
# Copy this file to .env and fill in your values

# Qoder CLI - Get token from https://qoder.com/account/integrations
# QODER_PERSONAL_ACCESS_TOKEN=your_token_here

# All provider API keys (OpenCode Zen, GitHub Models, Vercel AI Gateway,
# OVHcloud, Nscale, Aion Labs, LLM7, AI21, etc.) are managed centrally
# through the main OmniRouteAI admin UI at /api/admin/keys/<provider>.
# They are stored in Firestore and synced into Redis on server startup.
# Do not add provider keys here.
